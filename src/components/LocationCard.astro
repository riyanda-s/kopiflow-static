---
import { business } from '../config/business';
import { MapPin, ArrowUpRight } from '@lucide/astro';
---
<div class="location-card"><div class="location-art" aria-hidden="true"><div class="map-road road-one"></div><div class="map-road road-two"></div><div class="map-road road-three"></div><span class="map-park"></span><span class="map-pin"><MapPin size={32}/></span><span class="map-label">{business.name}</span><span class="map-disclaimer">{business.location.mapNote}</span></div><div class="location-content"><p class="eyebrow">{business.location.eyebrow}</p><h2>{business.location.greeting} {business.name}.</h2><p>{business.address}</p>{business.isDemo && <p class="fine-print">{business.location.demoNote}</p>}<a class="text-link" href={business.mapsUrl || '/visit/'} target={business.mapsUrl ? '_blank' : undefined} rel="noopener noreferrer">{business.mapsUrl ? 'Petunjuk arah' : 'Informasi lokasi'} <ArrowUpRight size={17}/></a></div></div>
