---
import { business } from '../config/business';
import { MapPin, ArrowUpRight } from '@lucide/astro';
---
<div class="location-card"><div class="location-art" aria-hidden="true"><div class="map-road road-one"></div><div class="map-road road-two"></div><div class="map-road road-three"></div><span class="map-park"></span><span class="map-pin"><MapPin size={32}/></span><span class="map-label">{business.name}</span><span class="map-disclaimer">ILLUSTRATIVE MAP · NOT A REAL LOCATION</span></div><div class="location-content"><p class="eyebrow">A SEAT IS WAITING</p><h2>See you at {business.name}.</h2><p>{business.address}</p>{business.isDemo && <p class="fine-print">Fictional demo. Address and opening hours are examples, not a real business listing.</p>}<a class="text-link" href={business.mapsUrl || '/visit/'} target={business.mapsUrl ? '_blank' : undefined} rel="noopener noreferrer">{business.mapsUrl ? 'Get directions' : 'Visit information'} <ArrowUpRight size={17}/></a></div></div>
