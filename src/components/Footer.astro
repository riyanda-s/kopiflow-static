---
import { business } from '../config/business';
---
<footer lang="id"><div class="shell footer-top"><div><a class="footer-brand" href="/">{business.name}<span aria-hidden="true">☀</span></a><p><span lang="en">{business.tagline}</span><br/>{business.footer.sentiment}</p></div><div><p class="eyebrow">{business.footer.moment}</p><a href="/menu/">Menu kami</a><a href="/about/">Cerita kami</a><a href="/visit/">Lokasi kedai</a></div><div><p class="eyebrow">{business.footer.connect}</p><a href="/visit/#contact">Kontak & petunjuk arah ↗</a><a href="/qr/">QR menu digital ↗</a><a href="/privacy/">Privasi</a></div><div><p class="eyebrow">{business.footer.hours}</p>{business.hours.map(h => <p class="footer-hours">{h.days}<br/><strong>{h.time}</strong></p>)}</div></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} {business.name}. {business.footer.credit}</span><span>{business.isDemo ? business.footer.demoNote : business.footer.customerNote}</span></div></footer>
