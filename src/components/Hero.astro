---
import { business } from '../config/business';
import CTAButton from './CTAButton.astro';
---
<section class="hero"><div class="hero-photo"><img src={business.images.hero} srcset={`${business.images.heroSmall} 800w, ${business.images.hero} 1600w`} sizes="100vw" width="1600" height="1067" alt={business.images.heroAlt} fetchpriority="high" /></div><div class="shell hero-inner"><p class="eyebrow"><span class="little-line"></span>{business.hero.eyebrow}</p><h1>{business.hero.title.split('\n').map(line => <span>{line}</span>)}</h1><p class="hero-copy">{business.hero.body.split('\n').map(line => <span>{line}</span>)}</p><div class="hero-buttons"><CTAButton href="/menu/">Lihat Menu</CTAButton><a href="/about/" class="text-link">{business.hero.storyCta} <span>→</span></a></div><div class="hero-caption"><span class="sun-mark" aria-hidden="true">☼</span><span>{business.hero.caption[0]}<br/>{business.hero.caption[1]}</span></div></div><a href="#favorites" class="hero-scroll">{business.hero.scroll} <span>↓</span></a></section>
