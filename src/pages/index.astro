---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CTAButton from '../components/CTAButton.astro';
import Gallery from '../components/Gallery.astro';
import LocationCard from '../components/LocationCard.astro';
import { Coffee, Armchair, Heart, ArrowUpRight } from '@lucide/astro';
import { business } from '../config/business';
import { menu } from '../data/menu';
---
<Layout><Hero/><div class="ritual-strip"><span>GOOD COFFEE</span><span aria-hidden="true">✳</span><span>SLOW MOMENTS</span><span aria-hidden="true">✳</span><span>WARM CONNECTIONS</span><span aria-hidden="true">✳</span><span>BREWED WITH CARE</span></div>
<section class="section shell" id="favorites"><div class="heading-row"><SectionHeading eyebrow="THE ONES YOU’LL COME BACK FOR" title="Meet your new favorites." text="Familiar comforts. A few happy discoveries. Always a good idea."/><a href="/menu/" class="text-link">View the full menu <ArrowUpRight size={18}/></a></div><ProductGrid products={menu.filter(p => p.featured)}/><p class="menu-footnote">{business.isDemo ? 'A taste of our fictional demo menu. ' : ''}Prices in IDR · All totals subject to shop confirmation.</p></section>
<section class="story-section"><div class="shell story-grid"><div class="story-image"><img src={business.images.story} width="900" height="1000" loading="lazy" alt={business.images.storyAlt}/><span class="story-stamp">SLOW DOWN<br/><span>☼</span><br/>STAY A WHILE</span></div><div class="story-copy"><SectionHeading eyebrow={business.story.eyebrow} title={business.story.title}/><p>{business.story.body}</p><p>{business.story.detail}</p><CTAButton href="/about/" secondary>More about our story</CTAButton><div class="signature">See you over coffee.</div></div></div></section>
<section class="section shell bestsellers"><div class="heading-row"><SectionHeading eyebrow="THE HOUSE SELECTION" title="A few more reasons to linger." text="Our best-seller selection: a bold brew, a fresh discovery, a sweet finish."/><a class="text-link" href="/menu/">Find your favorite <ArrowUpRight size={18}/></a></div><ProductGrid products={menu.filter(p => business.bestsellers.some(id => id === p.id))}/>{business.isDemo && <p class="menu-footnote">Illustrative best-seller picks for this fictional brand; no sales claims.</p>}</section>
<section class="section shell why-section"><SectionHeading eyebrow="MORE THAN A COFFEE STOP" title="Little things. Lasting moments."/><div class="values-grid">{business.philosophy.map((value, i) => { const Icon = [Coffee, Armchair, Heart][i]!; return <article><Icon size={30} stroke-width={1.3}/><h3>{value.title}</h3><p>{value.text}</p></article>; })}</div></section>
<section class="section shell gallery-section"><div class="heading-row"><SectionHeading eyebrow="A GLIMPSE OF THE GOOD LIFE" title="A little corner of calm."/><span class="gallery-note">Coffee, company, and everything in between.</span></div><Gallery/>{business.isDemo && <p class="menu-footnote">Illustrative photography for our fictional coffee house.</p>}</section>
<section class="promo shell"><span class="promo-sun" aria-hidden="true">☼</span><div><p class="eyebrow">{business.promotion.eyebrow}</p><h2>{business.promotion.title}</h2><p>{business.promotion.description}</p></div><CTAButton href="/menu/">{business.promotion.cta}</CTAButton></section>
<section class="section shell visit-section"><div class="opening"><p class="eyebrow">MAKE YOURSELF AT HOME</p><h2>There’s always time<br/>for a good cup.</h2>{business.hours.map(h => <div class="hours-row"><span>{h.days}</span><strong>{h.time}</strong></div>)}<p class="fine-print">{business.isDemo ? 'Example opening hours for this fictional demo.' : 'Contact us for holiday opening hours.'}</p><a href="/visit/#contact" class="text-link">Let’s talk on WhatsApp <ArrowUpRight size={16}/></a></div><LocationCard/></section>
</Layout>
