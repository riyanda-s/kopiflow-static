---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CTAButton from '../components/CTAButton.astro';
import Gallery from '../components/Gallery.astro';
import LocationCard from '../components/LocationCard.astro';
import { ArrowUpRight } from '@lucide/astro';
import { business } from '../config/business';
import { menu } from '../data/menu';
---
<Layout lang="id"><Hero/><div class="ritual-strip">{business.home.rituals.map((ritual, i) => <>{i > 0 && <span aria-hidden="true">✳</span>}<span>{ritual}</span></>)}</div>
<section class="section shell" id="favorites"><div class="heading-row"><SectionHeading eyebrow={business.home.favorites.eyebrow} title={business.home.favorites.title} text={business.home.favorites.text}/><a href="/menu/" class="text-link">{business.home.favorites.cta} <ArrowUpRight size={18}/></a></div><ProductGrid products={menu.filter(p => p.featured)}/><p class="menu-footnote">{business.isDemo ? business.home.demoMenuFootnote : ''}{business.home.menuFootnote}</p></section>
<section class="story-section"><div class="shell story-grid"><div class="story-image"><img src={business.images.story} width="900" height="1000" loading="lazy" alt={business.images.storyAlt}/><span class="story-stamp">{business.home.storyStamp[0]}<br/><span>☼</span><br/>{business.home.storyStamp[1]}</span></div><div class="story-copy"><SectionHeading eyebrow={business.story.eyebrow} title={business.story.title}/><p>{business.story.body}</p><p>{business.story.detail}</p><CTAButton href="/about/" secondary>{business.home.storyCta}</CTAButton><div class="signature">{business.home.signature}</div></div></div></section>
<section class="section shell bestsellers"><div class="heading-row"><SectionHeading eyebrow={business.home.selection.eyebrow} title={business.home.selection.title} text={business.home.selection.text}/><a class="text-link" href="/menu/">{business.home.selection.cta} <ArrowUpRight size={18}/></a></div><ProductGrid products={menu.filter(p => business.bestsellers.some(id => id === p.id))}/>{business.isDemo && <p class="menu-footnote">{business.home.selection.demoNote}</p>}</section>
<section class="section shell why-section"><SectionHeading eyebrow={business.home.values.eyebrow} title={business.home.values.title}/><div class="values-grid">{business.philosophy.map((value, i) => <article><span class="value-number">0{i + 1}</span><h3>{value.title}</h3><p>{value.text}</p></article>)}</div></section>
<section class="section shell gallery-section"><div class="heading-row"><SectionHeading eyebrow={business.home.gallery.eyebrow} title={business.home.gallery.title}/><span class="gallery-note">{business.home.gallery.note}</span></div><Gallery/>{business.isDemo && <p class="menu-footnote">{business.home.gallery.demoNote}</p>}</section>
<section class="promo shell"><span class="promo-sun" aria-hidden="true">☼</span><div><p class="eyebrow">{business.promotion.eyebrow}</p><h2>{business.promotion.title}</h2><p>{business.promotion.description}</p></div><CTAButton href="/menu/">{business.promotion.cta}</CTAButton></section>
<section class="section shell visit-section"><div class="opening"><p class="eyebrow">{business.home.opening.eyebrow}</p><h2>{business.home.opening.title}</h2>{business.hours.map(h => <div class="hours-row"><span>{h.days}</span><strong>{h.time}</strong></div>)}<p class="fine-print">{business.isDemo ? business.home.opening.demoNote : business.home.opening.holidayNote}</p><a href="/visit/#contact" class="text-link">{business.home.opening.cta} <ArrowUpRight size={16}/></a></div><LocationCard/></section>
</Layout>
