---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Gallery from '../components/Gallery.astro';
import CTAButton from '../components/CTAButton.astro';
import { business } from '../config/business';
---
<Layout title={`${business.about.title} | ${business.name}`}>
<section class="page-intro shell"><p class="eyebrow" lang="en">{business.tagline}</p><h1>{business.about.heading.split('\n').map((line, i) => <>{i > 0 && <br/>}{line}</>)}</h1><p>{business.about.intro}</p></section>
<section class="shell story-grid about-story"><img class="rounded-photo" src={business.images.story} width="900" height="1000" alt={business.images.storyAlt}/><div class="story-copy"><SectionHeading eyebrow={business.about.storyEyebrow} title={business.story.title}/><p>{business.story.body}</p><p>{business.story.detail}</p>{business.isDemo && <p class="demo-note">{business.name} {business.about.demoNote}</p>}</div></section>
<section class="section shell"><SectionHeading eyebrow={business.about.philosophyEyebrow} title={business.about.philosophyTitle}/><div class="values-grid">{business.philosophy.map((value, i) => <article><span class="value-number">0{i + 1}</span><h3>{value.title}</h3><p>{value.text}</p></article>)}</div><div class="quality-note"><h3>{business.coffeeQuality.title}</h3><p>{business.coffeeQuality.body}</p></div></section>
<section class="section shell"><SectionHeading eyebrow={business.about.galleryEyebrow} title={business.about.galleryTitle}/><Gallery/></section><section class="shell closing-cta"><p class="eyebrow">{business.about.closingEyebrow}</p><h2>{business.about.closingTitle}</h2><CTAButton href="/visit/">{business.about.closingCta}</CTAButton></section>
</Layout>
