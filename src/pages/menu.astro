---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import SearchInput from '../components/SearchInput.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { menu } from '../data/menu';
import { business } from '../config/business';
---
<Layout lang="id" title={`Menu | ${business.name}`} description="Temukan kopi, teh, dan camilan pilihan. Pilih ukuran, atur gula, dan siapkan pesan WhatsApp untuk dikonfirmasi kedai.">
<section class="page-intro shell"><p class="eyebrow">TEMAN UNTUK SETIAP SUASANA</p><h1>Secangkir untuk<br/>setiap cerita.</h1><p>Dari rasa yang akrab hingga pilihan baru.<br/>Temukan favorit Anda, nikmati tanpa terburu-buru.</p><span class="intro-decoration" aria-hidden="true">☼</span></section>
<section class="shell menu-section"><div class="menu-tools"><SearchInput/><p><span id="result-count">{menu.length}</span> pilihan untuk menemani hari</p></div><CategoryFilter/><p class="demo-note">{business.isDemo ? 'Menu demo fiktif · Foto stok hanya ilustrasi; produk tanpa foto ditandai dengan jelas. ' : ''}Harga merupakan estimasi. Ketersediaan dan total akhir perlu dikonfirmasi kedai.</p><h2 class="sr-only">Jelajahi menu</h2><ProductGrid products={menu}/><div id="no-results" hidden class="empty-state"><h2>Produk tidak ditemukan.</h2><p>Coba kata kunci atau kategori lain.</p><button id="reset-filters" class="button secondary">Tampilkan semua menu</button></div><p id="filter-status" class="sr-only" role="status"></p><noscript><p class="demo-note">Menu lengkap tersedia di atas. Aktifkan JavaScript untuk mencari, mengatur pilihan, dan menggunakan keranjang.</p></noscript></section>
</Layout>
