---
import Layout from '../layouts/Layout.astro';
import LocationCard from '../components/LocationCard.astro';
import { business } from '../config/business';
import { whatsappUrl } from '../utils/cart';
---
<Layout title={`Visit Us | ${business.name}`}><section class="page-intro shell"><p class="eyebrow">YOUR NEXT LITTLE ESCAPE</p><h1>Come for the coffee.<br/>Stay for the moment.</h1><p>We’d love to save you a corner of calm.</p></section><section class="shell visit-page"><LocationCard/><div class="visit-details"><div><p class="eyebrow">OPENING HOURS</p><h2>Good moments, daily.</h2>{business.hours.map(h => <div class="hours-row"><span>{h.days}</span><strong>{h.time}</strong></div>)}<p class="fine-print">{business.isDemo ? 'Sample opening hours only. This demo has no physical location.' : 'Please contact us to confirm holiday hours.'}</p></div><div id="contact"><p class="eyebrow">SAY HELLO</p><h2>Let’s keep in touch.</h2><p>Questions about the menu? Planning a coffee catch-up?</p>{business.isDemo ? <p class="demo-note">This is a fictional shop. WhatsApp, Instagram, and directions are unavailable until the owner configures real contact details.</p> : <div class="contact-links">{business.whatsapp && <a class="button" href={whatsappUrl(business.whatsapp, `Halo ${business.name}, saya ingin bertanya.`)} target="_blank" rel="noopener noreferrer">Chat on WhatsApp ↗</a>}{business.instagram && <a class="text-link" href={business.instagram} target="_blank" rel="noopener noreferrer">Find us on Instagram ↗</a>}{business.mapsUrl && <a class="text-link" href={business.mapsUrl} target="_blank" rel="noopener noreferrer">Get directions ↗</a>}</div>}</div></div></section></Layout>
