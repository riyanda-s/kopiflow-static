---
import Layout from '../layouts/Layout.astro';
import LocationCard from '../components/LocationCard.astro';
import { business } from '../config/business';
import { whatsappUrl } from '../utils/cart';
---
<Layout title={`${business.visit.title} | ${business.name}`}><section class="page-intro shell"><p class="eyebrow">{business.visit.eyebrow}</p><h1>{business.visit.heading.split('\n').map((line, i) => <>{i > 0 && <br/>}{line}</>)}</h1><p>{business.visit.intro}</p></section><section class="shell visit-page"><LocationCard/><div class="visit-details"><div><p class="eyebrow">{business.visit.hoursEyebrow}</p><h2>{business.visit.hoursTitle}</h2>{business.hours.map(h => <div class="hours-row"><span>{h.days}</span><strong>{h.time}</strong></div>)}<p class="fine-print">{business.isDemo ? business.visit.demoHours : business.visit.holidayHours}</p></div><div id="contact"><p class="eyebrow">{business.visit.contactEyebrow}</p><h2>{business.visit.contactTitle}</h2><p>{business.visit.contactIntro}</p>{business.isDemo ? <p class="demo-note">{business.visit.demoContact}</p> : <div class="contact-links">{business.whatsapp && <a class="button" href={whatsappUrl(business.whatsapp, `Halo ${business.name}, saya ingin bertanya.`)} target="_blank" rel="noopener noreferrer">Hubungi lewat WhatsApp ↗</a>}{business.instagram && <a class="text-link" href={business.instagram} target="_blank" rel="noopener noreferrer">Temukan kami di Instagram ↗</a>}{business.mapsUrl && <a class="text-link" href={business.mapsUrl} target="_blank" rel="noopener noreferrer">Petunjuk arah ↗</a>}</div>}</div></div></section></Layout>
